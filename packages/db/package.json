{
  "name": "@portal/db",
  "private": true,
  "version": "0.1.0",
  "description": "PORTAL Supabase schema, migrations and seed",
  "scripts": {
    "db:start": "supabase start --workdir .",
    "db:stop": "supabase stop --workdir .",
    "db:reset": "supabase db reset --workdir .",
    "db:diff": "supabase db diff --workdir .",
    "db:types": "supabase gen types typescript --local --workdir . > ../shared/src/database.types.ts"
  },
  "devDependencies": {
    "supabase": "^2.0.0"
  }
}
