# Local Supabase (pnpm --filter @portal/db db:start)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
# Stripe TEST publishable key (pk_test_...) — safe to ship in the app,
# unlike the secret key (sk_...) which lives ONLY in Edge Function secrets.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
